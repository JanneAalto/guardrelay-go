[Unit]
Description=GuardRelay (SmartPi->MQTT relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guardrelay
Group=guardrelay
StateDirectory=guardrelay
StateDirectoryMode=0700
Environment=ENERGY_STATE_FILE=/var/lib/guardrelay/energy.json
EnvironmentFile=/etc/default/guardrelay
ExecStart=/usr/local/bin/guardrelay
Restart=always
RestartSec=5

# Service hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
